# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.tox/
