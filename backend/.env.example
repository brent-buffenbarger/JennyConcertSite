OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6
OPENAI_ENRICHMENT_ENABLED=true

# Admin credentials required for every write endpoint (add, edit, upload, delete, sync).
# Leaving either empty makes writes return 503 so the backend fails closed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Comma-separated list of front-end origins allowed to call the API in production.
# Include both the Cloudflare Pages preview URL and any custom domain you use.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
