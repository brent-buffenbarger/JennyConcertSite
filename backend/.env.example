OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6
OPENAI_ENRICHMENT_ENABLED=true

# Comma-separated list of front-end origins allowed to call the API in production.
# Include both the Cloudflare Pages preview URL and any custom domain you use.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret required by POST /api/concerts/publish-notes.
# Your Shortcut sends this in the X-Publish-Token header so only your trusted
# devices can publish Apple Notes content to the cloud backend.
PUBLISH_NOTES_TOKEN=change-me-to-a-long-random-string
