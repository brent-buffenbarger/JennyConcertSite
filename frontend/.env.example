# Frontend build-time environment.
# Copy this to .env.local for development, and set the same variables in your
# Cloudflare Pages project settings for production.

# The absolute URL of the backend API. Leave blank for local dev (Vite proxy or same-origin).
# In production, set this to your Cloudflare Tunnel hostname, e.g.:
# VITE_API_BASE_URL=https://api.jennyconcerts.com
VITE_API_BASE_URL=
